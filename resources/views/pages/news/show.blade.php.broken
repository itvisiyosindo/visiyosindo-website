    {{-- Reading Progress Bar --}}
    <div 
        x-data="{ 
            progress: 0,
            updateProgress() {
                const winHeight = window.innerHeight;
                const docHeight = document.documentElement.scrollHeight;
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                const trackLength = docHeight - winHeight;
                this.progress = Math.floor(scrollTop / trackLength * 100);
            }
        }"
        x-init="updateProgress(); window.addEventListener('scroll', () => updateProgress())"
        class="fixed top-0 left-0 right-0 z-50 h-1 bg-slate-200 dark:bg-slate-700"
    >
        <div 
            class="h-full bg-gradient-to-r from-blue-600 to-cyan-600 transition-all duration-150"
            :style="`width: ${progress}%`"
        ></div>
    </div>

