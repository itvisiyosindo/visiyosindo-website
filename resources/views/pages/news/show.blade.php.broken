@php
    $pageTitle = $post->meta_title ?? $post->title;
    $pageDescription = $post->meta_description ?? ($post->excerpt ? Str::limit($post->excerpt, 160) : '');
    $pageKeywords = is_array($post->meta_keywords) ? implode(', ', $post->meta_keywords) : ($post->meta_keywords ?? '');
    $ogImageUrl = $post->og_image ? asset('storage/' . $post->og_image) : ($post->featured_image ? asset('storage/' . $post->featured_image) : null);
    $pageCanonical = $post->canonical_url ?? route('news.detail', $post->slug);
@endphp

